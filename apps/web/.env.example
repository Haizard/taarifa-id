# ---- Database (all optional; resolution order below) ----
# 1. DATABASE_URL                    explicit override (e.g. local dev or other Postgres)
# 2. supabase_session_pooler         Supabase session pooler  (recommended for serverless)
# 3. supabase_transaction_pooler     Supabase transaction pooler
# 4. supabase_direct_connection_string
# 5. fallback: postgresql://taarifa:taarifa_dev_2026@localhost:5432/taarifa_id
DATABASE_URL=
supabase_session_pooler=
supabase_transaction_pooler=
supabase_direct_connection_string=
supabase_db_password=
# Set to "true" to force SSL (auto-enabled for *.supabase.co / *.pooler.supabase.com hosts)
DATABASE_SSL=

# ---- Auth ----
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# ---- App ----
# Public origin used when generating QR codes (defaults to http://localhost:3000)
WEB_URL=

# ---- Serverless tuning (optional) ----
# Max Postgres pool size per serverless instance (default 1)
PG_MAX_CONNECTIONS=1
