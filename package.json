{
  "name": "taarifa-id",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev": "pnpm run dev:api & pnpm run dev:web",
    "dev:api": "pnpm --filter @taarifa/api run start:dev",
    "dev:web": "pnpm --filter @taarifa/web run dev",
    "db:push": "pnpm --filter @taarifa/db run push",
    "db:seed": "pnpm --filter @taarifa/db run seed"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
