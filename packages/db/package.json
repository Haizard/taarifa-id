{
  "name": "@taarifa/db",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "require": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "prepare": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "push": "drizzle-kit push",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-kit": "^0.31.0",
    "pg": "catalog:",
    "dotenv": "^16.5.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "bcryptjs": "catalog:"
  }
}
